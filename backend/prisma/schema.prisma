// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())


  email        String @unique
  passwordHash String

  // null until the email is confirmed
  emailVerifiedAt DateTime?
  // token fields store a sha-256 hash, not the token
  verificationTokenHash String?
  verificationSentAt    DateTime?
  verificationExpiresAt DateTime?


  resetTokenHash  String?
  resetSentAt     DateTime?
  resetExpiresAt  DateTime?

  createdAt DateTime @default(now())

  // Student profile
  name            String?
  age             String?
  phone           String?
  isMinor         Boolean @default(false)
  sponsorName     String?
  sponsorEmail    String?
  instrument      String?
  experience      String?
  level           String?
  instructionType String?
  coStudentName   String?
  plan            String?
  status          String  @default("active")

  // set from a verified Stripe event only
  paidAt   DateTime?
  payments Payment[]

  // customer id is used to match renewal invoices to the user
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  // { weeklyMinutes, weeklyGoal, streak, achievements: [] }
  practiceStats Json?
}

// provider is "stripe" or "demo". Amounts in cents.
model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  description String?
  amountCents Int
  currency    String   @default("usd")
  provider    String   @default("demo")
  status      String   @default("paid")
  createdAt   DateTime @default(now())

  // Stripe checkout session id or invoice id. Unique so a retried webhook
  // can't record the same payment twice.
  providerRef String? @unique

  @@index([userId])
}

// used by @quixo3/prisma-session-store
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model TrialRequest {
  id           String   @id @default(uuid())
  studentName  String
  age          String?
  guardian     String?
  email        String
  phone        String?
  instrument   String?
  format       String?
  experience   String?
  availability String?
  favorites    String?
  goals        String?
  notes        String?
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  reason     String?
  age        String?
  instrument String?
  message    String
  prefer     String?
  createdAt  DateTime @default(now())
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  bio         String?
  instruments String?
  photoUrl    String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Song {
  id         String   @id @default(uuid())
  title      String
  artist     String?
  level      String?
  instrument String?
  notes      String?
  published  Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model OnStagePost {
  id          String   @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  date        String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  nav       String?
  status    String   @default("Draft")
  body      String?
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(uuid())
  name      String
  type      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  label     String
  kind      String?
  url       String?
  updatedAt DateTime @updatedAt
}


model Lesson {
  id         String   @id @default(uuid())
  order      Int      @default(0)
  title      String
  artist     String?
  key        String?
  difficulty String?
  estTime    String?
  levels     Json?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  videos LessonVideo[]
}

// One video per (lesson, instrument, level, kind). Most slots start empty.
model LessonVideo {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // must match User.instrument (see INSTRUMENTS in lib/lessonVideos.js)
  instrument String

  // 1-5, only level 1 recorded so far
  level Int @default(1)

  // "lesson" or "playthrough"
  kind String @default("lesson")

  // "bunny" (Bunny Stream guid) or "direct" (plain URL, used in dev)
  provider String @default("bunny")


  videoId String

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@unique([lessonId, instrument, level, kind])
  @@index([lessonId])
}

// Admin text overrides for public pages, e.g. key "format.hero.title".
// Deleting a row restores the original text.
model SiteText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
