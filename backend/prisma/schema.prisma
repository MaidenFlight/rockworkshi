// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  // Email and password are the only way in, so every account must have both.
  email        String @unique
  passwordHash String

  // Null until the address is confirmed. Unverified accounts can sign in but
  // are held at the "check your inbox" step by nextStepFor().
  emailVerifiedAt DateTime?
  // Sha-256 of the emailed token, never the token itself — a leaked table
  // shouldn't let someone else confirm an address.
  verificationTokenHash String?
  verificationSentAt    DateTime?
  verificationExpiresAt DateTime?

  // Same treatment for password resets, on a much shorter fuse: this token is
  // enough to take over the account.
  resetTokenHash  String?
  resetSentAt     DateTime?
  resetExpiresAt  DateTime?

  createdAt DateTime @default(now())

  // Student profile (filled in at signup / editable by admin)
  name            String?
  age             String?
  phone           String?
  isMinor         Boolean @default(false)
  sponsorName     String?
  sponsorEmail    String?
  instrument      String?
  experience      String?
  level           String?
  instructionType String?
  coStudentName   String?
  plan            String?
  status          String  @default("active")

  // Set once enrolment is paid for. Currently written by the demo checkout;
  // a real processor should set it from a verified webhook instead.
  paidAt   DateTime?
  payments Payment[]

  // Simple derived dashboard stats: { weeklyMinutes, weeklyGoal, streak, achievements: [] }
  practiceStats Json?
}

// One row per payment attempt. "provider" records what settled it — today only
// "demo", so these rows are not evidence of money changing hands. Amounts are
// integer cents to keep float rounding out of billing.
model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  description String?
  amountCents Int
  currency    String   @default("usd")
  provider    String   @default("demo")
  status      String   @default("paid")
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Shape required by @quixo3/prisma-session-store
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model TrialRequest {
  id           String   @id @default(uuid())
  studentName  String
  age          String?
  guardian     String?
  email        String
  phone        String?
  instrument   String?
  format       String?
  experience   String?
  availability String?
  favorites    String?
  goals        String?
  notes        String?
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  reason     String?
  age        String?
  instrument String?
  message    String
  prefer     String?
  createdAt  DateTime @default(now())
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  bio         String?
  instruments String?
  photoUrl    String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Song {
  id         String   @id @default(uuid())
  title      String
  artist     String?
  level      String?
  instrument String?
  notes      String?
  published  Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model OnStagePost {
  id          String   @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  date        String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  nav       String?
  status    String   @default("Draft")
  body      String?
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(uuid())
  name      String
  type      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  label     String
  kind      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Lesson {
  id                  String   @id @default(uuid())
  order               Int      @default(0)
  title               String
  artist              String?
  key                 String?
  difficulty          String?
  estTime             String?
  videoUrl            String?
  playthroughVideoUrl String?
  levels              Json?
  published           Boolean  @default(true)
  createdAt           DateTime @default(now())
}
