// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  // Email and password are the only way in, so every account must have both.
  email        String @unique
  passwordHash String

  // Null until the address is confirmed. Unverified accounts can sign in but
  // are held at the "check your inbox" step by nextStepFor().
  emailVerifiedAt DateTime?
  // Sha-256 of the emailed token, never the token itself — a leaked table
  // shouldn't let someone else confirm an address.
  verificationTokenHash String?
  verificationSentAt    DateTime?
  verificationExpiresAt DateTime?

  // Same treatment for password resets, on a much shorter fuse: this token is
  // enough to take over the account.
  resetTokenHash  String?
  resetSentAt     DateTime?
  resetExpiresAt  DateTime?

  createdAt DateTime @default(now())

  // Student profile (filled in at signup / editable by admin)
  name            String?
  age             String?
  phone           String?
  isMinor         Boolean @default(false)
  sponsorName     String?
  sponsorEmail    String?
  instrument      String?
  experience      String?
  level           String?
  instructionType String?
  coStudentName   String?
  plan            String?
  status          String  @default("active")

  // Set once enrolment is paid for. Written from a verified Stripe event, never
  // from anything the browser reports — returning to the success page is not
  // proof that money moved.
  paidAt   DateTime?
  payments Payment[]

  // Stripe's own identifiers for this account. The customer id is what links a
  // renewal invoice arriving months later back to a row in this table: the
  // checkout session is long finished by then, so it can't do that job.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  // Simple derived dashboard stats: { weeklyMinutes, weeklyGoal, streak, achievements: [] }
  practiceStats Json?
}

// One row per payment attempt. "provider" records what settled it — "stripe"
// for real money, "demo" for the development stand-in, so the two are always
// tellable apart in the history. Amounts are integer cents to keep float
// rounding out of billing.
model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  description String?
  amountCents Int
  currency    String   @default("usd")
  provider    String   @default("demo")
  status      String   @default("paid")
  createdAt   DateTime @default(now())

  // The processor's id for this charge — the Checkout Session for a first
  // payment, the Invoice for a renewal. Unique because webhook delivery is
  // at-least-once: Stripe retries until it gets a 2xx, and the same event
  // arriving twice must not write two rows. The insert races the return from
  // the success page, so the constraint is what settles it, not a prior read.
  providerRef String? @unique

  @@index([userId])
}

// Shape required by @quixo3/prisma-session-store
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model TrialRequest {
  id           String   @id @default(uuid())
  studentName  String
  age          String?
  guardian     String?
  email        String
  phone        String?
  instrument   String?
  format       String?
  experience   String?
  availability String?
  favorites    String?
  goals        String?
  notes        String?
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  reason     String?
  age        String?
  instrument String?
  message    String
  prefer     String?
  createdAt  DateTime @default(now())
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  bio         String?
  instruments String?
  photoUrl    String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Song {
  id         String   @id @default(uuid())
  title      String
  artist     String?
  level      String?
  instrument String?
  notes      String?
  published  Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model OnStagePost {
  id          String   @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  date        String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  nav       String?
  status    String   @default("Draft")
  body      String?
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(uuid())
  name      String
  type      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  label     String
  kind      String?
  url       String?
  updatedAt DateTime @updatedAt
}

// A song as it's taught: the title, key and level descriptions are the same
// whoever is playing it. The videos are not — see LessonVideo.
model Lesson {
  id         String   @id @default(uuid())
  order      Int      @default(0)
  title      String
  artist     String?
  key        String?
  difficulty String?
  estTime    String?
  levels     Json?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  videos LessonVideo[]
}

// One playable video. The same song is taught differently on every instrument,
// and eventually at every level, so a video can't be a column on Lesson — there
// is one per (lesson, instrument, level, kind), and most of those slots stay
// empty for a long time while the library is being recorded.
model LessonVideo {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // One of the six names in frontend/lib/content.js. Signup stores that same
  // string on User.instrument and the two are matched by string, so they have
  // to stay identical — a rename on either side silently hides every video.
  instrument String

  // Only level 1 is being recorded for now. The column exists from the start so
  // that adding levels later is content entry, not a migration against rows
  // that by then have real videos and paying students behind them.
  level Int @default(1)

  // "lesson" for the teaching video, "playthrough" for the song played straight.
  kind String @default("lesson")

  // How to turn videoId into something playable: "bunny" means it's a Bunny
  // Stream guid and the URL gets signed per request; "direct" means videoId is
  // already a plain URL, which is what local development and any leftover
  // placeholder use.
  provider String @default("bunny")

  // The host's id for the video, deliberately not a full URL — a signed URL
  // expires, so storing one would mean storing something already stale.
  videoId String

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One video per slot, so re-uploading replaces a row rather than leaving two
  // that disagree about which is current.
  @@unique([lessonId, instrument, level, kind])
  @@index([lessonId])
}
