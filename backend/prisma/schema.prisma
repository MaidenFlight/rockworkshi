// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  // null until the email is confirmed
  emailVerifiedAt       DateTime?
  // token fields store a sha-256 hash, not the token
  verificationTokenHash String?
  verificationSentAt    DateTime?
  verificationExpiresAt DateTime?

  resetTokenHash String?
  resetSentAt    DateTime?
  resetExpiresAt DateTime?

  createdAt DateTime @default(now())

  // Student profile
  name            String?
  age             String?
  phone           String?
  isMinor         Boolean @default(false)
  sponsorName     String?
  sponsorEmail    String?
  instrument      String?
  experience      String?
  level           String?
  instructionType String?
  coStudentName   String?
  plan            String?
  status          String  @default("active")

  // set from a verified Stripe event only
  paidAt   DateTime?
  payments Payment[]

  // customer id is used to match renewal invoices to the user
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  // { weeklyMinutes, weeklyGoal, streak, achievements: [] }
  practiceStats Json?

  // "student" or "teacher" (see ROLES in lib/assignments.js). The admin isn't a role:
  // it's whoever signs in with ADMIN_EMAIL.
  role String @default("student")

  // Set only on student demo accounts (lib/demo.js): made for one visitor who pressed "Try student
  // demo", never signed into with a password, kept out of every staff list, and deleted with
  // everything they own when the visitor leaves or this time passes.
  demoExpiresAt DateTime?

  // Set by the admin. A teacher can only assign to and review students linked here.
  myStudents TeacherStudent[] @relation("TeacherSide")
  myTeachers TeacherStudent[] @relation("StudentSide")

  assignmentsGiven    Assignment[] @relation("AssignmentTeacher")
  assignmentsReceived Assignment[] @relation("AssignmentStudent")
  monthsTaught        PracticeMonth[] @relation("MonthTeacher")
  practiceMonths      PracticeMonth[] @relation("MonthStudent")
  monthPlans          MonthPlan[]     @relation("PlanTeacher")
  monthPlanSeats      MonthPlanStudent[]

  mixPresets MixPreset[]
  practice   SongPractice[]

  // Teaching groups. Set by staff only; paying for a plan never adds one.
  termEnrollments TermEnrollment[]
  termGrants      TermGrant[]

  // Phase 1: roles beyond User.role, the student's own profile, classes and guardians.
  roles           UserRole[]
  profile         StudentProfile?
  instruments     InstrumentSkill[]
  availability    Availability[]
  classesTaught   Class[]           @relation("ClassTeacher")
  classEnrolments ClassEnrollment[]
  attendance      Attendance[]
  consents        ConsentRecord[]   @relation("ConsentStudent")
  consentsGiven   ConsentRecord[]   @relation("ConsentGiver")
  guardianOf      GuardianLink[]    @relation("GuardianSide")
  guardians       GuardianLink[]    @relation("GuardedSide")

  // Live meetings (sing-alongs) and the notifications about them.
  meetingsCreated   Meeting[]                @relation("MeetingCreator")
  meetingInvites    MeetingInvite[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  notifyPreference  NotificationPreference?

  @@index([demoExpiresAt])
}

// A live room on the site that an admin runs: Brian's sing-along. A monthly series is one row per
// date sharing a seriesId, so one date can move or be cancelled on its own. startsAt is UTC; the site
// shows and takes it in Hawaii time.
model Meeting {
  id              String    @id @default(uuid())
  seriesId        String?
  title           String
  description     String?
  startsAt        DateTime
  durationMinutes Int
  // When the date or time was last set. A reminder only goes out if the time was already set when
  // the reminder came due, so a meeting made (or moved) at short notice skips the 24-hour one.
  timeSetAt       DateTime  @default(now())
  status          String    @default("scheduled") // "scheduled" | "live" | "ended" | "cancelled"
  startedAt       DateTime?
  endedAt         DateTime?
  // Who is invited: a class (its enrolled students, kept up to date) and/or students picked by name.
  classId         String?
  createdById     String?
  createdBy       User?     @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invites MeetingInvite[]

  @@index([startsAt])
  @@index([seriesId])
  @@index([status, startsAt])
}

// The students a meeting is for, worked out when it's saved (and again when it starts). Guardians
// are reached through their GuardianLink, never stored here.
model MeetingInvite {
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  viaClass  Boolean @default(false)

  @@id([meetingId, userId])
  @@index([userId])
}

// The in-site inbox. dedupeKey names the event and the person, so making the same notification twice
// (a retried request, a reminder pass running twice) finds the first one instead.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey String    @unique
  kind      String // "meeting.scheduled" | "meeting.rescheduled" | "meeting.cancelled" | "meeting.started" | "meeting.reminder"
  meetingId String?
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

// Email or browser push for one notification. One row per channel, so a delivery is attempted once and
// a retry picks up only what didn't go: "pending" -> "sending" (claimed) -> "sent" | "failed" | "skipped".
model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String // "email" | "push"
  status         String       @default("pending")
  attempts       Int          @default(0)
  claimedAt      DateTime?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, channel])
  @@index([status, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Email and browser push are chosen separately. Email is on until turned off; push also needs this
// browser to have said yes (a PushSubscription).
model NotificationPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// One student's own state for one song: favourite, private notes, and where they left off.
// Kept apart from MixPreset on purpose: automatic resume never touches a named preset.
model SongPractice {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  favorite     Boolean   @default(false)
  notes        String? // private to the student
  lastOpenedAt DateTime? // drives the "Continue practising" card

  // Resume state: position plus the practice settings the player supports (mode, mix,
  // effects, and on the phone speed and loop). Validated by lib/practice.js. Saved every
  // so often while playing and on pause or leave, never on every playhead tick.
  session        Json?
  sessionSavedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, songId])
  @@index([userId, lastOpenedAt])
}

// A student's named mixer settings for one song (stem volumes, mute/solo, take effects).
// settings is validated by lib/mixPresets.js before it's stored.
model MixPreset {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  name     String
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Saving under an existing name replaces that preset.
  @@unique([userId, songId, name])
}

// Links a teacher account to a student account. Not related to the Teacher model,
// which holds the public bios on the Teachers page.
model TeacherStudent {
  teacherId String
  teacher   User     @relation("TeacherSide", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentSide", fields: [studentId], references: [id], onDelete: Cascade)
  // The teacher's private notes about this student. Never shown to the student or a guardian.
  notes     String?
  createdAt DateTime @default(now())

  @@id([teacherId, studentId])
  @@index([studentId])
}

// Practice work a teacher sets for one student.
model Assignment {
  id        String  @id @default(uuid())
  // Null once the teacher's account is deleted: the work and feedback belong to the student.
  teacherId String?
  teacher   User?   @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  studentId String
  student   User    @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  // Exactly one is set when the assignment is created. Deleting the song or lesson
  // later keeps the assignment and its feedback, so it's SetNull rather than Cascade.
  songId   String?
  song     Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  instrument   String // one of INSTRUMENTS in lib/lessonVideos.js
  level        Int // 1-5, the song levels (Sing-a-long ... Improv)
  section      String? // e.g. "Chorus"
  // Optional part of a song in seconds. The phone player loops it.
  sectionStart Float?
  sectionEnd   Float?
  instruction  String

  // "assigned" -> "ready" (student asked for review) -> "reviewed".
  // Submitting again after feedback goes back to "ready".
  // A checkpoint goes to "saved" instead of "ready": its take is there to look at, outside the
  // teacher's review queue, unless reviewCheckpoint asks for it to be in the queue.
  status String @default("assigned")

  // A task in a month of practice (null for work set on its own), its week (1-4), and where it comes
  // in that month's list.
  monthId  String?
  month    PracticeMonth? @relation(fields: [monthId], references: [id], onDelete: SetNull)
  week     Int?
  position Int            @default(0)
  // The last day to do it, "YYYY-MM-DD" in Pacific/Honolulu.
  dueOn    String?
  // Which task of the month's plan this came from (an id in MonthPlan.tasks). Null for work set any
  // other way, which a plan never touches.
  planTaskId String?

  // "checkpoint" (small, repeatable practice) or "assessment" (a take the student submits on purpose).
  // Everything set before there were checkpoints counts as an assessment: it goes to the teacher.
  kind             String  @default("assessment")
  reviewCheckpoint Boolean @default(false)
  // What the take has to be. Null support or targetSpeed means any: all work set before these existed.
  media            String  @default("audio") // "audio" | "video"
  audioAllowed     Boolean @default(false) // on a video task, audio is accepted instead
  support          String? // "guide" | "chart" | "solo", the most help a final take may use
  targetSpeed      Int? // percent of full speed, 50-100
  criteria         Json? // ["Steady timing", ...]: what the teacher marks

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]
  uploads     RecordingUpload[]

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([monthId])
}

// A month of practice on one song for one student: four weeks of tasks, set by the teacher.
model PracticeMonth {
  id        String  @id @default(uuid())
  // Null once the teacher's account is deleted: the work belongs to the student.
  teacherId String?
  teacher   User?   @relation("MonthTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  studentId String
  student   User    @relation("MonthStudent", fields: [studentId], references: [id], onDelete: Cascade)
  songId    String?
  song      Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  // The first day of week 1, "YYYY-MM-DD" in Pacific/Honolulu.
  startsOn   String
  weekTitles Json // four short names, one per week

  // The plan this month was published from, if any, and the version of it this student last took.
  // Null for a month set any other way.
  planId      String?
  plan        MonthPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Assignment[]

  // Publishing twice can't give a student the same plan twice. Months with no plan don't count.
  @@unique([planId, studentId])
  @@index([studentId])
  @@index([teacherId])
}

// A teacher's working document for a month on one song: a plan for particular students, or a reusable
// template. Nothing in here reaches a student. Publishing makes an ordinary PracticeMonth and
// Assignments for each student (lib/monthPlans.js), so their pages, takes and reviews are the same as
// for any other month, and changing a plan or a template never changes anyone's work until the teacher
// has seen what it would do and applied it.
model MonthPlan {
  id        String @id @default(uuid())
  // Plans belong to the teacher who made them and go with their account. Months already published
  // keep going without them (PracticeMonth.planId is SetNull).
  teacherId String
  teacher   User   @relation("PlanTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  kind       String // "plan" | "template"
  name       String
  instrument String // one of INSTRUMENTS in lib/lessonVideos.js: what it was written for
  level      Int // 1-5, the song levels. Templates are organised by this and the instrument.
  songId     String?
  song       Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  // The first day of week 1, "YYYY-MM-DD" in Pacific/Honolulu. A template has no dates of its own.
  startsOn   String?
  // The class it was made for, for the record and to offer anyone who has joined it since.
  classId    String?
  class      Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  weekTitles Json // four short names, one per week
  // The working copy: [{ id, week, position, kind, section, sectionStart, sectionEnd, instruction,
  // level, media, audioAllowed, support, targetSpeed, dueDay, criteria, reviewCheckpoint }]. dueDay
  // is days after the first day, so moving the start moves every due date with it.
  tasks      Json

  // Goes up with every save, so a save made from an out-of-date copy can be refused.
  revision Int @default(0)
  // The newest snapshot in MonthPlanVersion. 0 means none yet: a draft never published.
  version  Int @default(0)

  // The template this plan was copied from, and which version of it this plan has taken.
  templateId      String?
  template        MonthPlan?  @relation("PlanTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  copies          MonthPlan[] @relation("PlanTemplate")
  templateVersion Int?

  publishedAt DateTime?
  // Archived plans stay intact and can be restored. They're only hidden from the working lists.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students MonthPlanStudent[]
  versions MonthPlanVersion[]
  months   PracticeMonth[]

  @@index([teacherId, kind])
  @@index([templateId])
}

// Who a plan is for, and what's different for this student: { taskId: { skip: true } or
// { targetSpeed, support, media, audioAllowed, dueDay, instruction } }. Staff only.
model MonthPlanStudent {
  planId    String
  plan      MonthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overrides Json?
  createdAt DateTime  @default(now())

  @@id([planId, studentId])
  @@index([studentId])
}

// A plan or template as it stood at a moment that matters: when it was published or changes were
// applied, or each time a template was saved. Later changes are worked out against these, which is how
// an individual student's own settings are told apart from what the plan said.
model MonthPlanVersion {
  planId      String
  plan        MonthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version     Int
  startsOn    String?
  weekTitles  Json
  tasks       Json
  createdById String?
  createdAt   DateTime  @default(now())

  @@id([planId, version])
}

// A video on its way up in pieces (R2 multipart). Kept so a dropped connection can pick up where it
// stopped, and so ones nobody came back for can be cancelled.
model RecordingUpload {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  key         String    @unique // the R2 object it will become
  uploadId    String // R2's id for the multipart upload
  contentType String
  size        Int
  partSize    Int
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([assignmentId])
}

// One "ready for review" from the student, with an optional recording and the teacher's feedback.
model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  // R2 object key, not a URL. Only the student and their teacher get a short-lived link.
  recordingKey      String? @unique
  // Song position the recording's first sample lines up with, so it plays in time with the band.
  recordingOffset   Float?
  recordingDuration Float?

  // Private: only the student and the teacher who set the assignment can read it.
  feedback   String?
  reviewedAt DateTime?
  // The teacher's notes tied to moments: [{ at: seconds into the song, text }], sorted by time.
  // Saved with the feedback (lib/assignments.js validateNotes).
  notes      Json?
  // The teacher's mark for each of the task's criteria: [{ criterion, mark }], and up to two
  // priorities for next week. Saved with the feedback.
  marks      Json?
  priorities Json?

  // How this take was made. Each send keeps its own, whatever the task asks for later.
  media         String  @default("audio") // "audio" | "video"
  recordingType String? // its content type; null is an older WAV
  recordingSize Int?
  speed         Float? // the song's speed while recording; null is full speed
  support       String? // "guide" | "chart" | "solo", the most help used during it

  createdAt DateTime @default(now())

  @@index([assignmentId])
}

// provider is "stripe" or "demo". Amounts in cents.
model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  description String?
  amountCents Int
  currency    String   @default("usd")
  provider    String   @default("demo")
  status      String   @default("paid")
  createdAt   DateTime @default(now())

  // Stripe checkout session id or invoice id. Unique so a retried webhook
  // can't record the same payment twice.
  providerRef String? @unique

  @@index([userId])
}

// used by @quixo3/prisma-session-store
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model TrialRequest {
  id           String   @id @default(uuid())
  studentName  String
  age          String?
  guardian     String?
  email        String
  phone        String?
  instrument   String?
  format       String?
  experience   String?
  availability String?
  favorites    String?
  goals        String?
  notes        String?
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  reason     String?
  age        String?
  instrument String?
  message    String
  prefer     String?
  createdAt  DateTime @default(now())
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  bio         String?
  instruments String?
  photoUrl    String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Song {
  id         String   @id @default(uuid())
  title      String
  artist     String?
  level      String?
  instrument String?
  notes      String?
  published  Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt

  tracks      SongTrack[]
  mixes       SongMix[]
  videos      LessonVideo[]
  assignments Assignment[]
  mixPresets  MixPreset[]
  practice    SongPractice[]
  classes     Class[]
  termSlots   TermSlot[]
  termGrants  TermGrant[]
  months      PracticeMonth[]
  monthPlans  MonthPlan[]

  // How loud the stems are played together: the 99.999th percentile of the summed
  // sample level (1.0 = full scale). Stems often sum well past full scale, so the
  // players turn the mix down by this much. Set by songs:upload / songs:measure.
  mixLevel Float?

  // Chords and when each starts in the stems (lib/chordChart.js). Set by songs:chart.
  chart Json?
}

// One audio stem of a song, stored in R2. Playing every stem together is the full song.
model SongTrack {
  id     String @id @default(uuid())
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  // "Vocals", "Guitar", "Keys", "Bass", "Drums" or "Ukulele" (see PARTS in lib/songTracks.js)
  part String

  // Object key in the R2 bucket, not a URL: download URLs are signed and expire.
  storageKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([songId, part])
  @@index([songId])
}

// A track mixed ahead of time from a song's stems, so a student can play along without being sent
// other instruments' stems one by one (lib/instrumentAccess.js). `without` names the stem left out:
// "Guitar" is everything but the guitar, a guitar student's backing band. "" is every stem, the whole
// song, for a student whose instrument has no stem in the recording. Made by songs:backing.
model SongMix {
  id         String   @id @default(uuid())
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  without    String
  // Object key in storage (R2, or MEDIA_DIR in development), not a URL.
  storageKey String
  // The mix was turned down by this much so it can't clip; the players turn it back up.
  gain       Float
  // Fingerprint of the stems it was made from (lib/songMixes.js). Once a stem is replaced the
  // fingerprint no longer matches, and the mix isn't served until it's made again.
  sources    String
  createdAt  DateTime @default(now())

  @@unique([songId, without])
}

model OnStagePost {
  id          String   @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  date        String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  nav       String?
  status    String   @default("Draft")
  body      String?
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(uuid())
  name      String
  type      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  label     String
  kind      String?
  url       String?
  updatedAt DateTime @updatedAt
}

model Lesson {
  id         String   @id @default(uuid())
  order      Int      @default(0)
  title      String
  artist     String?
  key        String?
  difficulty String?
  estTime    String?
  levels     Json?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  videos      LessonVideo[]
  assignments Assignment[]
  termSlots   TermSlot[]
  termGrants  TermGrant[]
}

// One video per (lesson or song, instrument, level, kind). Most slots start empty.
// A row belongs to exactly one lesson or one song (a CHECK in the migration enforces it).
// A song's videos are its tutorials, shown above the practice player.
model LessonVideo {
  id       String  @id @default(uuid())
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  songId   String?
  song     Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)

  // must match User.instrument (see INSTRUMENTS in lib/lessonVideos.js)
  instrument String

  // 1-5, only level 1 recorded so far
  level Int @default(1)

  // "lesson" or "playthrough"
  kind String @default("lesson")

  // "bunny" (Bunny Stream guid) or "direct" (plain URL, used in dev)
  provider String @default("bunny")

  videoId String

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, instrument, level, kind])
  @@unique([songId, instrument, level, kind])
  @@index([lessonId])
}

// The student demo's passcode (lib/demo.js). An admin sets it and gives it to the people they choose;
// with no row the demo is closed. Stored as a bcrypt hash, like account passwords. One row, id 1.
model DemoAccess {
  id           Int      @id @default(1)
  passcodeHash String
  setBy        String?
  updatedAt    DateTime @updatedAt
}

// Admin text overrides for public pages, e.g. key "format.hero.title".
// Deleting a row restores the original text.
model SiteText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A shared three-month teaching term. Students in the group unlock one song a month on the
// group's schedule (not their own signup date). Separate from billing: the Term plan pays
// for access and never enrols anyone. See lib/termAccess.js for the access rules.
// All DateTimes are UTC instants; staff enter and read them in Pacific/Honolulu.
model TermGroup {
  id       String   @id @default(uuid())
  name     String
  startsAt DateTime // 00:00 Honolulu on the first day
  endsAt   DateTime // 23:59:59.999 Honolulu on the last day

  slots   TermSlot[]
  members TermEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One month of a term. A slot's song is available to the group's students only once
// unlockAt has passed (server time) AND staff have published it.
model TermSlot {
  id       String    @id @default(uuid())
  groupId  String
  group    TermGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month    Int // 1, 2 or 3
  unlockAt DateTime

  // Optional until staff are ready. Deleting the song or lesson empties the slot.
  songId   String?
  song     Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  published   Boolean   @default(false)
  publishedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([groupId, month])
  @@index([songId])
  @@index([lessonId])
}

model TermEnrollment {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     TermGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, groupId])
  @@index([groupId])
}

// A term song or lesson a student has already reached. Once a month has opened for a
// student they keep it (owner's decision: "once they pass the song, they should have
// access"), even after the term ends, they leave the group, or staff change that month.
// The paid-membership check still applies on top.
model TermGrant {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId    String?
  song      Song?    @relation(fields: [songId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // The term it came from, for the record. Not a relation, so it outlives a deleted term.
  groupId   String?
  grantedAt DateTime @default(now())

  @@unique([userId, songId])
  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------------------------
// Phase 1 of the platform plan (docs/platform-plan.md): roles, profiles, classes, guardians.
// ---------------------------------------------------------------------------------------------

// Roles a person holds, on top of User.role (kept for the phone app and older code). One of
// "teacher", "admin", "guardian". The ADMIN_EMAIL account is always an admin. Granted by an admin
// and recorded in the audit log.
model UserRole {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  grantedBy String?
  createdAt DateTime @default(now())

  @@id([userId, role])
}

// What a student chooses to tell the school about themselves. Every field is optional. A minor's
// profile is only stored once a guardian has consented (ConsentRecord purpose "profile").
model StudentProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ageBracket          String? // "under-13" | "13-17" | "18+", self-declared, never inferred
  area                String? // a general area the student names, never worked out from their IP
  goals               String?
  rehearsalFormat     String? // "online" | "in-person" | "either"
  genres              String[]
  favouriteArtists    String?
  learningPreferences String? // in the student's own words
  bandInterest        Boolean  @default(false)
  performInterest     Boolean  @default(false)
  productionInterest  Boolean  @default(false)
  // "teachers": the student's linked teachers and admins can read it. "private": only the student.
  visibility          String   @default("teachers")
  updatedAt           DateTime @updatedAt
}

// One row per instrument a student plays. The student's own view of their level and a teacher's
// assessment are kept apart on purpose.
model InstrumentSkill {
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument   String // one of INSTRUMENTS in lib/lessonVideos.js
  primary      Boolean @default(false)
  selfLevel    String?
  teacherLevel String?
  assessedBy   String?

  @@id([userId, instrument])
}

// A weekly window someone is usually free, in their own time zone.
model Availability {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday     Int // 0 Sunday ... 6 Saturday
  startMinute Int // minutes after local midnight
  endMinute   Int
  timeZone    String

  @@index([userId])
}

// A lesson, group class, workshop, rehearsal or performance. Its time is a local wall-clock time in
// the teacher's chosen time zone, so a weekly lesson stays at 4pm across daylight-saving changes.
// The dated sessions are ClassOccurrence rows, generated ahead of time.
model Class {
  id              String   @id @default(uuid())
  teacherId       String?
  teacher         User?    @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  kind            String // "lesson" | "group" | "workshop" | "rehearsal" | "performance"
  title           String
  description     String?
  level           String?
  instruments     String[]
  topics          String?
  capacity        Int?
  timeZone        String // IANA, e.g. "Pacific/Honolulu"
  firstDate       String // "YYYY-MM-DD" in timeZone
  startMinute     Int // minutes after local midnight
  durationMinutes Int
  repeat          String   @default("none") // "none" | "weekly" | "monthly"
  repeatUntil     String? // "YYYY-MM-DD" in timeZone, inclusive
  meetingUrl      String? // a pasted link works before any video integration
  songId          String?
  song            Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)
  status          String   @default("active") // "active" | "cancelled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occurrences ClassOccurrence[]
  enrolments  ClassEnrollment[]
  monthPlans  MonthPlan[]

  @@index([teacherId])
}

model ClassOccurrence {
  id        String    @id @default(uuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt  DateTime // UTC
  endsAt    DateTime
  status    String    @default("scheduled") // "scheduled" | "cancelled"
  // Set when this one session was moved away from the class's usual time. Regenerating the
  // series (after the class's time changes) leaves moved and cancelled sessions alone.
  movedFrom DateTime?
  notes     String? // the teacher's private notes for this session

  attendance Attendance[]

  @@index([classId, startsAt])
  @@index([startsAt])
}

// Who is in a class. Only an admin enrols. Over capacity, a student waits; when a place frees up
// the longest-waiting student moves in.
model ClassEnrollment {
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("enrolled") // "enrolled" | "waitlisted"
  createdAt DateTime @default(now())

  @@id([classId, userId])
  @@index([userId])
}

model Attendance {
  occurrenceId String
  occurrence   ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String // "present" | "late" | "absent" | "excused"
  source       String          @default("teacher") // "teacher" | "provider"
  updatedAt    DateTime        @updatedAt

  @@id([occurrenceId, userId])
}

// Consent is a history: each change is a new row, and the latest row for a purpose is the answer.
// A minor's consent is given by a linked guardian.
model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("ConsentStudent", fields: [userId], references: [id], onDelete: Cascade)
  givenById String?
  givenBy   User?    @relation("ConsentGiver", fields: [givenById], references: [id], onDelete: SetNull)
  purpose   String // "profile" | "share-practice" | "band-matching"
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

// A parent or guardian, invited by an admin to the email address the school has on file.
// guardianId is filled in when they accept.
model GuardianLink {
  id              String    @id @default(uuid())
  studentId       String
  student         User      @relation("GuardedSide", fields: [studentId], references: [id], onDelete: Cascade)
  guardianId      String?
  guardian        User?     @relation("GuardianSide", fields: [guardianId], references: [id], onDelete: Cascade)
  email           String
  relationship    String? // "parent" | "guardian"
  invitedBy       String?
  inviteTokenHash String?   @unique // sha-256 of the emailed token, single use
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([guardianId])
  @@index([studentId])
}

// Sensitive administrative changes: roles, enrolments, guardians, consent.
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}
