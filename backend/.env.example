# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Must match the Postgres creds in the root .env used by docker-compose.yml.
DATABASE_URL="postgresql://rockworks:changeme@localhost:5432/rockworks_dev?schema=public"

# Express server
PORT=4000
NODE_ENV=development

# Any long random string — used to sign the session ID cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Where the Next.js frontend runs — used for CORS and for the redirect at the
# end of email verification.
FRONTEND_URL=http://localhost:3000

# How this API is reached from a browser. Only needed if that differs from
# http://localhost:PORT — verification links are built from it, so they must
# point somewhere the person reading the email can actually open.
# API_PUBLIC_URL=http://localhost:4000

# Signed-in users with this email are treated as admin (isAdmin: true on /auth/me).
ADMIN_EMAIL=dennylandika1996@gmail.com

# Outbound email (verification links). Any SMTP provider works.
# Leave blank in development and messages go to a disposable Ethereal inbox
# instead — the server logs a URL to view each one. Production refuses to start
# a fallback, so these must be set there.
#
# Some hosts block outbound SMTP on the standard ports to deter spam — Render
# does, on 587 — and a blocked port times out rather than refusing, so the only
# clue is a slow request and "Connection timeout" in the logs. Resend also
# listens on 2465 and 2587 for exactly this; use 2587, which is the STARTTLS one
# and so needs no other change. Check any port with: npm run mail:check -- you@x
#
#   Resend    host smtp.resend.com  port 587  user "resend"  pass = API key
#             (or port 2587 if 587 is blocked where this is deployed)
#             Until you verify a domain, MAIL_FROM has to be
#             onboarding@resend.dev and Resend only delivers to the address
#             the account was registered with. rockworksschoolofmusichawaii.com
#             is verified, so MAIL_FROM can be an address there and reach
#             anyone.
#   Gmail     host smtp.gmail.com   port 587  — SMTP_PASS must be an App
#             Password from https://myaccount.google.com/apppasswords
#             (needs 2-Step Verification on), not your normal password, and
#             MAIL_FROM must be that same Gmail address.
#   SendGrid  host smtp.sendgrid.net port 587 user "apikey"  pass = API key
#
# Check whatever you set with:  npm run mail:check -- you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address the provider lets you send from, or it'll be rejected.
MAIL_FROM="Rock Works School of Music <denny.landika@rockworksschoolofmusichawaii.com>"

# Where replies go. Verifying a sending domain with Resend does NOT create a
# mailbox on it, so the MAIL_FROM address above can send but cannot receive —
# a student hitting Reply would get a bounce. The code defaults to the Northwest
# mailbox that does exist on the domain, so this only needs setting if that inbox
# changes. Set it to an empty string to send no Reply-To header at all.
#
# Note the Northwest free email plan allows 5 sends per day from that mailbox.
# That is a limit on replying by hand from webmail; it has nothing to do with
# the app's mail, which goes out through Resend.
MAIL_REPLY_TO=denny.landika@rockworksschoolofmusichawaii.com

# Stripe. Leave these blank and the site falls back to the demo checkout below,
# so a fresh clone still runs the whole enrolment flow. Set them and the Pay
# button hands off to Stripe's hosted checkout instead — card details are typed
# there, never on this site, which keeps card data out of scope entirely.
#
# Keys live at https://dashboard.stripe.com/apikeys. Mind the Test mode toggle:
# sk_test_… can't move real money, sk_live_… can. The checkout screen shows
# which one is in force rather than guessing from NODE_ENV, because the two can
# disagree.
#
# Amounts are never configured here or in the Stripe dashboard — they come from
# src/lib/plans.js on every request, so there is only one copy to keep right.
STRIPE_SECRET_KEY=
# Verifies that a webhook really came from Stripe. The endpoint is public, so
# without this anyone could POST "this account paid" at it. Get it from the
# webhook's own page in the dashboard, or from `stripe listen` when testing
# locally — they are different secrets, and the local one changes per run.
STRIPE_WEBHOOK_SECRET=

# The demo checkout grants paid access without taking money, so it is only
# available when NODE_ENV is not "production". Set this to "true" to force it on
# anyway — a staging box, say. Never set it on a real deployment: it would let
# anyone enrol for free.
# ALLOW_DEMO_PAYMENTS=false
