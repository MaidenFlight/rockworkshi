# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Must match the Postgres creds in the root .env used by docker-compose.yml.
DATABASE_URL="postgresql://rockworks:changeme@localhost:5432/rockworks_dev?schema=public"

# Express server
PORT=4000
NODE_ENV=development

# Any long random string — used to sign the session ID cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials
# — Authorized redirect URI: http://localhost:4000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the Next.js frontend runs — used for CORS and post-OAuth redirects.
FRONTEND_URL=http://localhost:3000
