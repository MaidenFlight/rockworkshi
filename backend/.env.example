# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Must match the Postgres creds in the root .env used by docker-compose.yml.
DATABASE_URL="postgresql://rockworks:changeme@localhost:5432/rockworks_dev?schema=public"

# Express server
PORT=4000
NODE_ENV=development

# Any long random string — used to sign the session ID cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Where the Next.js frontend runs — used for CORS and for the redirect at the
# end of email verification.
FRONTEND_URL=http://localhost:3000

# How this API is reached from a browser. Only needed if that differs from
# http://localhost:PORT — verification links are built from it, so they must
# point somewhere the person reading the email can actually open.
# API_PUBLIC_URL=http://localhost:4000

# Signed-in users with this email are treated as admin (isAdmin: true on /auth/me).
ADMIN_EMAIL=dennylandika1996@gmail.com

# Outbound email (verification links). Any SMTP provider works.
# Leave blank in development and messages go to a disposable Ethereal inbox
# instead — the server logs a URL to view each one. Production refuses to start
# a fallback, so these must be set there.
#
#   Gmail     host smtp.gmail.com   port 587  — SMTP_PASS must be an App
#             Password from https://myaccount.google.com/apppasswords
#             (needs 2-Step Verification on), not your normal password.
#   Resend    host smtp.resend.com  port 587  user "resend"  pass = API key
#   SendGrid  host smtp.sendgrid.net port 587 user "apikey"  pass = API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address the provider lets you send from, or it'll be rejected.
MAIL_FROM="Rock Works School of Music <aloha@rockworks.music>"

# The demo checkout grants paid access without taking money, so it is only
# available when NODE_ENV is not "production". Set this to "true" to force it on
# anyway — a staging box, say. Never set it on a real deployment: it would let
# anyone enrol for free.
# ALLOW_DEMO_PAYMENTS=false
