# Must match the Postgres settings in the root .env (docker-compose.yml).
DATABASE_URL="postgresql://rockworks:changeme@localhost:5432/rockworks_dev?schema=public"

PORT=4000
NODE_ENV=development

# Long random string used to sign the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Frontend origin, used for CORS and links in emails.
FRONTEND_URL=http://localhost:3000

# Only needed if the API is reached on a different URL than localhost:PORT.
# API_PUBLIC_URL=http://localhost:4000

# This account gets admin access.
ADMIN_EMAIL=dennylandika1996@gmail.com

# SMTP. Leave blank in dev to use an Ethereal test inbox (preview URL is logged).
# Required in production.
#
#   Resend    smtp.resend.com    port 587 (or 2587 on Render, which blocks 587)
#             user "resend", pass = API key
#   Gmail     smtp.gmail.com     port 587, pass = app password
#   SendGrid  smtp.sendgrid.net  port 587, user "apikey", pass = API key
#
# Test with: npm run mail:check -- you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rock Works School of Music <denny.landika@rockworksschoolofmusichawaii.com>"
# Set to an empty string to send without a Reply-To header.
MAIL_REPLY_TO=denny.landika@rockworksschoolofmusichawaii.com

# Stripe. Leave blank in dev to use the demo checkout instead.
# Prices come from src/lib/plans.js, not the Stripe dashboard.
STRIPE_SECRET_KEY=
# From the webhook settings in the dashboard, or from `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=

# Demo checkout is disabled in production. Only enable this on staging.
# ALLOW_DEMO_PAYMENTS=false
